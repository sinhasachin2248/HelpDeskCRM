</style>

@section Scripts
{
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
        $(document).ready(function() {

            // PREMIUM FLOATING TICKET PORTAL INTERACTIONS
            function updateTicketLayout() {
                var page = $(".ticket-management-page");
                var width = window.innerWidth;

                page.removeClass("ticket-mobile ticket-small");

                if (width <= 900) {
                    page.addClass("ticket-mobile");
                }

                if (width <= 600) {
                    page.addClass("ticket-small");
                }
            }

            updateTicketLayout();
            $(window).on("resize", updateTicketLayout);

            // Cursor-responsive ambient motion.
            $(document).on("mousemove", function(event) {
                var x = (event.clientX / window.innerWidth) - 0.5;
                var y = (event.clientY / window.innerHeight) - 0.5;

                $(".ticket-glow-1").css(
                    "transform",
                    "translate(" + (x * 22) + "px," + (y * 18) + "px)"
                );

                $(".ticket-glow-2").css(
                    "transform",
                    "translate(" + (x * -18) + "px," + (y * -15) + "px)"
                );

                $(".ticket-glow-3").css(
                    "transform",
                    "translate(" + (x * 12) + "px," + (y * -10) + "px)"
                );

                $(".ticket-orbit-1").css(
                    "transform",
                    "translate(" + (x * -13) + "px," + (y * 9) + "px)"
                );

                $(".ticket-orbit-2").css(
                    "transform",
                    "translate(" + (x * 10) + "px," + (y * -8) + "px)"
                );
            });

            var ticketFloatStep = 0;

            setInterval(function() {
                ticketFloatStep++;

                $(".ticket-particle-1").css("transform",
                    "translate(" + Math.sin(ticketFloatStep / 11) * 18 + "px," +
                    Math.cos(ticketFloatStep / 15) * 13 + "px)");

                $(".ticket-particle-2").css("transform",
                    "translate(" + Math.cos(ticketFloatStep / 13) * 15 + "px," +
                    Math.sin(ticketFloatStep / 10) * 18 + "px)");

                $(".ticket-particle-3").css("transform",
                    "translate(" + Math.sin(ticketFloatStep / 9) * 14 + "px," +
                    Math.cos(ticketFloatStep / 12) * 17 + "px)");

                $(".ticket-particle-4").css("transform",
                    "translate(" + Math.cos(ticketFloatStep / 16) * 18 + "px," +
                    Math.sin(ticketFloatStep / 12) * 12 + "px)");

                $(".ticket-particle-5").css("transform",
                    "translate(" + Math.sin(ticketFloatStep / 14) * 12 + "px," +
                    Math.cos(ticketFloatStep / 17) * 15 + "px)");
            }, 120);


            function showValidation(message) {
                alert(message);
            }

            function validateTicketForm() {

                var customer = $("#ticketCustomer").val();
                var subject = $("#ticketSubject").val().trim();
                var description = $("#ticketDescription").val().trim();
                var priority = $("#ticketPriority").val();
                var status = $("#ticketStatus").val();

                // CUSTOMER
                if (customer === "" || customer === null) {
                    showValidation("Customer is required.");
                    $("#ticketCustomer").focus();
                    return false;
                }

                // SUBJECT
                if (subject === "") {
                    showValidation("Ticket Subject is required.");
                    $("#ticketSubject").focus();
                    return false;
                }

                if (subject.length < 5) {
                    showValidation("Ticket Subject must be at least 5 characters.");
                    $("#ticketSubject").focus();
                    return false;
                }

                // DESCRIPTION
                if (description === "") {
                    showValidation("Ticket Description is required.");
                    $("#ticketDescription").focus();
                    return false;
                }

                if (description.length < 10) {
                    showValidation("Ticket Description must be at least 10 characters.");
                    $("#ticketDescription").focus();
                    return false;
                }

                // PRIORITY
                if (priority === "" || priority === null) {
                    showValidation("Priority is required.");
                    $("#ticketPriority").focus();
                    return false;
                }

                // STATUS
                if (status === "" || status === null) {
                    showValidation("Status is required.");
                    $("#ticketStatus").focus();
                    return false;
                }

                return true;
            }

            // CREATE TICKET SUBMIT
            $("#ticketForm").on("submit", function(event) {
                if (!validateTicketForm()) {
                    event.preventDefault();
                    return false;
                }
                return true;
            });

            // RUNTIME BLUR VALIDATIONS (WITHOUT FOCUS LOOP)
            $("#ticketSubject").on("blur", function() {
                var subject = $(this).val().trim();
                if (subject !== "" && subject.length < 5) {
                    showValidation("Ticket Subject must be at least 5 characters.");
                }
            });

            $("#ticketDescription").on("blur", function() {
                var description = $(this).val().trim();
                if (description !== "" && description.length < 10) {
                    showValidation("Ticket Description must be at least 10 characters.");
                }
            });

            // CLEAR FORM
            $("#btnClearTicket").on("click", function() {
                $("#ticketForm")[0].reset();
            });

            // SEARCH FORM VALIDATION
            $("#ticketSearchForm").on("submit", function(event) {
                var ticketId = $("#searchTicketId").val().trim();

                if (ticketId === "") {
                    event.preventDefault();
                    showValidation("Ticket ID is required.");
                    $("#searchTicketId").focus();
                    return false;
                }

                if (!/^[0-9]+$/.test(ticketId) || Number(ticketId) <= 0) {
                    event.preventDefault();
                    showValidation("Please enter a valid Ticket ID.");
                    $("#searchTicketId").focus();
                    return false;
                }

                return true;
            });

            // ASSIGN EMPLOYEE VALIDATION
            $("#assignEmployeeForm").on("submit", function(event) {
                var employeeId = $("#assignEmployeeId").val();

                if (employeeId === "" || employeeId === null) {
                    event.preventDefault();
                    showValidation("Please select an employee before assigning the ticket.");
                    $("#assignEmployeeId").focus();
                    return false;
                }

                return true;
            });

        });
    </script>
}