    /* JS-controlled responsive classes */
    .ticket-management-page.ticket-mobile .ticket-hero {
        align-items: flex-start;
        flex-direction: column;
    }

    .ticket-management-page.ticket-mobile .ticket-hero-status {
        align-self: flex-start;
    }

    .ticket-management-page.ticket-small .ticket-hero {
        padding: 22px 19px;
    }

        .ticket-management-page.ticket-small .ticket-hero h1 {
            font-size: 25px;
        }

