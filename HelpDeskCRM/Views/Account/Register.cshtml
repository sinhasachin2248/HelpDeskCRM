        }


    /* =========================================================
       MOBILE
    ========================================================= */

    .register-shell.mobile-register {
        display: block;
        width: min(600px, calc(100vw - 28px));
    }


        .register-shell.mobile-register
        .register-showcase {
            display: none;
        }


        .register-shell.mobile-register
        .register-form-panel {
            padding: 35px 25px 25px;
        }


    .register-shell.small-register {
        width: min(600px, calc(100vw - 24px));
    }


        .register-shell.small-register
        .register-form-panel {
            padding-left: 20px;
            padding-right: 20px;
        }


        .register-shell.small-register
        .requirement-list {
            grid-template-columns: 1fr;
        }


    /* =========================================================
       JAVASCRIPT RESPONSIVE SUPPORT
    ========================================================= */

</style>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {


                const shell =
                    document.querySelector(
                        ".register-shell"
                    );


                function updateRegisterLayout() {

                    if (!shell) {
                        return;
                    }


                    const width =
                        window.innerWidth;


                    shell.classList.remove(
                        "mobile-register",
                        "small-register"
                    );


                    if (width <= 900) {

                        shell.classList.add(
                            "mobile-register"
                        );

                    }


                    if (width <= 600) {

                        shell.classList.add(
                            "small-register"
                        );

                    }

                }


                updateRegisterLayout();


                window.addEventListener(
                    "resize",
                    updateRegisterLayout
                );


                /* =================================================
                   PASSWORD ELEMENTS
                ================================================== */

                const password =
                    document.getElementById(
                        "adminPassword"
                    );


                const confirmPassword =
                    document.getElementById(
                        "adminConfirmPassword"
                    );


                const passwordToggle =
                    document.getElementById(
                        "adminPasswordToggle"
                    );


                const confirmToggle =
                    document.getElementById(
                        "confirmPasswordToggle"
                    );


                /* =================================================
                   PASSWORD SHOW / HIDE
                ================================================== */

                function setupPasswordToggle(
                    input,
                    button
                ) {

                    if (!input || !button) {
                        return;
                    }


                    button.addEventListener(
                        "click",
                        function() {

                            if (
                                input.type ===
                                "password"
                            ) {

                                input.type =
                                    "text";

                                button.textContent =
                                    "◌";

                            }
                            else {

                                input.type =
                                    "password";

                                button.textContent =
                                    "◉";

                            }

                        }
                    );

                }


                setupPasswordToggle(
                    password,
                    passwordToggle
                );


                setupPasswordToggle(
                    confirmPassword,
                    confirmToggle
                );


                /* =================================================
                   PASSWORD REQUIREMENTS
                ================================================== */

                function updateRule(
                    id,
                    valid
                ) {

                    const element =
                        document.getElementById(
                            id
                        );


                    if (!element) {
                        return;
                    }


                    const icon =
                        element.querySelector(
                            "span"
                        );


                    if (valid) {

                        element.classList.add(
                            "valid"
                        );


                        if (icon) {
                            icon.textContent =
                                "✓";
                        }

                    }
                    else {

                        element.classList.remove(
                            "valid"
                        );


                        if (icon) {
                            icon.textContent =
                                "○";
                        }

                    }

                }


                function validatePassword() {

                    if (!password) {
                        return false;
                    }


                    const value =
                        password.value;


                    const lengthValid =
                        value.length >= 8 &&
                        value.length <= 16;


                    const upperValid =
                        /[A-Z]/.test(value);


                    const lowerValid =
                        /[a-z]/.test(value);


                    const numberValid =
                        /[0-9]/.test(value);


                    const symbolValid =
                        /[^a-zA-Z0-9]/.test(value);


                    updateRule(
                        "lengthRule",
                        lengthValid
                    );


                    updateRule(
                        "upperRule",
                        upperValid
                    );


                    updateRule(
                        "lowerRule",
                        lowerValid
                    );


                    updateRule(
                        "numberRule",
                        numberValid
                    );


                    updateRule(
                        "symbolRule",
                        symbolValid
                    );


                    return (
                        lengthValid &&
                        upperValid &&
                        lowerValid &&
                        numberValid &&
                        symbolValid
                    );

                }


                /* =================================================
                   CONFIRM PASSWORD
                ================================================== */

                function validateConfirmPassword() {

                    if (
                        !password ||
                        !confirmPassword
                    ) {
                        return false;
                    }


                    const message =
                        document.getElementById(
                            "confirmPasswordMessage"
                        );


                    if (
                        confirmPassword.value ===
                        ""
                    ) {

                        message.textContent =
                            "";

                        return false;

                    }


                    if (
                        password.value ===
                        confirmPassword.value
                    ) {

                        message.textContent =
                            "✓ Passwords match";

                        message.style.color =
                            "#16a34a";

                        return true;

                    }


                    message.textContent =
                        "✗ Passwords do not match";

                    message.style.color =
                        "#e11d48";

                    return false;

                }


                if (password) {

                    password.addEventListener(
                        "input",
                        function() {

                            validatePassword();

                            validateConfirmPassword();

                        }
                    );

                }


                if (confirmPassword) {

                    confirmPassword.addEventListener(
                        "input",
                        function() {

                            validateConfirmPassword();

                        }
                    );

                }


                /* =================================================
                   FORM BUTTON INTERACTION
                ================================================== */

                const form =
                    document.getElementById(
                        "adminRegisterForm"
                    );


                const button =
                    document.getElementById(
                        "createAdminButton"
                    );


                if (
                    form &&
                    button
                ) {

                    form.addEventListener(
                        "submit",
                        function() {

                            if (
                                form.checkValidity()
                            ) {

                                button.style.transform =
                                    "scale(.985)";

                                button.style.opacity =
                                    ".88";

                            }

                        }
                    );

                }


                /* =================================================
                   BACKGROUND MOUSE MOVEMENT
                ================================================== */

                const page =
                    document.querySelector(
                        ".admin-register-page"
                    );


                const orbOne =
                    document.querySelector(
                        ".register-orb-one"
                    );


                const orbTwo =
                    document.querySelector(
                        ".register-orb-two"
                    );


                if (
                    page &&
                    orbOne &&
                    orbTwo
                ) {

                    page.addEventListener(
                        "mousemove",
                        function(event) {

                            const x =
                                (
                                    event.clientX /
                                    window.innerWidth
                                ) - .5;


                            const y =
                                (
                                    event.clientY /
                                    window.innerHeight
                                ) - .5;


                            orbOne.style.transform =
                                "translate(" +
                                (x * 16) +
                                "px," +
                                (y * 16) +
                                "px)";


                            orbTwo.style.transform =
                                "translate(" +
                                (x * -14) +
                                "px," +
                                (y * -14) +
                                "px)";

                        }
                    );

                }

            }
        );

    </script>
}