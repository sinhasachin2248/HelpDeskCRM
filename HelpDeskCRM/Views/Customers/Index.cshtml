@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
        $(document).ready(function() {

            // PREMIUM PORTAL INTERACTIONS
            function updateCustomerPortalLayout() {
                var page = $(".container-fluid");
                var width = window.innerWidth;

                page.removeClass("customer-portal-mobile customer-portal-small");

                if (width <= 900) {
                    page.addClass("customer-portal-mobile");
                }

                if (width <= 600) {
                    page.addClass("customer-portal-small");
                }
            }

            updateCustomerPortalLayout();
            $(window).on("resize", updateCustomerPortalLayout);

            // Gentle cursor-responsive floating background.
            $(document).on("mousemove", function(event) {
                var x = (event.clientX / window.innerWidth) - 0.5;
                var y = (event.clientY / window.innerHeight) - 0.5;

                $(".glow-a").css("transform",
                    "translate(" + (x * 18) + "px," + (y * 18) + "px)");

                $(".glow-b").css("transform",
                    "translate(" + (x * -15) + "px," + (y * -15) + "px)");

                $(".glow-c").css("transform",
                    "translate(" + (x * 10) + "px," + (y * -10) + "px)");

                $(".orbit-a").css("transform",
                    "translate(" + (x * -12) + "px," + (y * 8) + "px)");

                $(".orbit-b").css("transform",
                    "translate(" + (x * 10) + "px," + (y * -8) + "px)");
            });

            // Slowly shift particles to create a floating atmosphere.
            var particleStep = 0;

            setInterval(function() {
                particleStep++;

                $(".particle-a").css("transform",
                    "translate(" + Math.sin(particleStep / 12) * 18 + "px," +
                    Math.cos(particleStep / 15) * 14 + "px)");

                $(".particle-b").css("transform",
                    "translate(" + Math.cos(particleStep / 14) * 15 + "px," +
                    Math.sin(particleStep / 11) * 18 + "px)");

                $(".particle-c").css("transform",
                    "translate(" + Math.sin(particleStep / 10) * 14 + "px," +
                    Math.cos(particleStep / 13) * 17 + "px)");

                $(".particle-d").css("transform",
                    "translate(" + Math.cos(particleStep / 16) * 18 + "px," +
                    Math.sin(particleStep / 12) * 12 + "px)");

                $(".particle-e").css("transform",
                    "translate(" + Math.sin(particleStep / 13) * 12 + "px," +
                    Math.cos(particleStep / 17) * 15 + "px)");
            }, 120);

            // Give clickable customer rows a subtle depth response.
            $(".table tbody tr").on("mouseenter", function() {
                $(this).css("box-shadow", "0 8px 22px rgba(39,31,99,.06)");
            }).on("mouseleave", function() {
                $(this).css("box-shadow", "none");
            });


            function isValidEmail(email) {
                var emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/;
                return emailPattern.test(email);
            }

            function isValidPhone(phone) {
                var phonePattern = /^[6-9][0-9]{9}$/;
                return phonePattern.test(phone);
            }

            function showValidation(message) {
                alert(message);
            }

            function validateCustomerForm() {
                var firstName = $("#firstName").val().trim();
                var lastName = $("#lastName").val().trim();
                var email = $("#customerEmail").val().trim();
                var phone = $("#customerPhone").val().trim();
                var company = $("#companyName").val().trim();
                var city = $("#customerCity").val();

                // FIRST NAME
                if (firstName === "") {
                    showValidation("First Name is required.");
                    $("#firstName").focus();
                    return false;
                }

                if (!/^[a-zA-Z ]+$/.test(firstName)) {
                    showValidation("First Name can contain only letters.");
                    $("#firstName").focus();
                    return false;
                }

                // LAST NAME
                if (lastName === "") {
                    showValidation("Last Name is required.");
                    $("#lastName").focus();
                    return false;
                }

                if (!/^[a-zA-Z ]+$/.test(lastName)) {
                    showValidation("Last Name can contain only letters.");
                    $("#lastName").focus();
                    return false;
                }

                // EMAIL
                if (email === "") {
                    showValidation("Email is required.");
                    $("#customerEmail").focus();
                    return false;
                }

                if (!isValidEmail(email)) {
                    showValidation("Please enter a valid email address.\n\nExample: customer@gmail.com");
                    $("#customerEmail").focus();
                    return false;
                }

                // PHONE
                if (phone === "") {
                    showValidation("Phone number is required.");
                    $("#customerPhone").focus();
                    return false;
                }

                if (!isValidPhone(phone)) {
                    showValidation("Phone number must be exactly 10 digits and start with 6-9.");
                    $("#customerPhone").focus();
                    return false;
                }

                // COMPANY
                if (company === "") {
                    showValidation("Company Name is required.");
                    $("#companyName").focus();
                    return false;
                }

                // CITY
                if (city === "") {
                    showValidation("City is required.");
                    $("#customerCity").focus();
                    return false;
                }

                return true;
            }

            // FORM SUBMIT HANDLER
            $("#customerForm").on("submit", function(event) {
                if (!validateCustomerForm()) {
                    event.preventDefault();
                    return false;
                }
                return true;
            });

            // PHONE NUMERIC-ONLY FILTER
            $("#customerPhone").on("input", function() {
                var value = $(this).val().replace(/[^0-9]/g, "");
                $(this).val(value);
            });

            // BLUR VALIDATIONS (WITHOUT FOCUS LOOP)
            $("#customerEmail").on("blur", function() {
                var email = $(this).val().trim();
                if (email !== "" && !isValidEmail(email)) {
                    showValidation("Please enter a valid email address.");
                }
            });

            $("#customerPhone").on("blur", function() {
                var phone = $(this).val().trim();
                if (phone !== "" && !isValidPhone(phone)) {
                    showValidation("Phone number must be exactly 10 digits and start with 6-9.");
                }
            });

            $("#firstName").on("blur", function() {
                var value = $(this).val().trim();
                if (value !== "" && !/^[a-zA-Z ]+$/.test(value)) {
                    showValidation("First Name can contain only letters.");
                }
            });

            $("#lastName").on("blur", function() {
                var value = $(this).val().trim();
                if (value !== "" && !/^[a-zA-Z ]+$/.test(value)) {
                    showValidation("Last Name can contain only letters.");
                }
            });

            // CLEAR FORM
            $("#btnClearCustomer").on("click", function() {
                $("#firstName").val("");
                $("#lastName").val("");
                $("#customerEmail").val("");
                $("#customerPhone").val("");
                $("#companyName").val("");
                $("#customerCity").val("");
            });

        });
    </script>
}