@model HelpDeskCRM.Models.Admin

@{
    ViewData["Title"] = "Update Admin";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-6">

            <div class="card border-0 shadow-lg"
                 style="border-radius:18px; overflow:hidden;">

                <div class="p-4 text-white"
                     style="background:linear-gradient(135deg,#37318b,#5b4de8);">

                    <h3 class="mb-1">
                        ✏️ Update Admin
                    </h3>

                    <p class="mb-0">
                        Update administrator information
                    </p>

                </div>


                <div class="card-body p-4">


                    <form asp-controller="Admin"
                          asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()


                        <input type="hidden"
                               name="AdminId"
                               value="@Model.AdminId" />


                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Admin ID
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.AdminId"
                                   disabled />

                        </div>


                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Admin Name
                            </label>

                            <input type="text"
                                   name="AdminName"
                                   value="@Model.AdminName"
                                   class="form-control"
                                   required />

                            <span class="text-danger"
                                  asp-validation-for="AdminName">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                User ID
                            </label>

                            <input type="text"
                                   name="UserId"
                                   value="@Model.UserId"
                                   class="form-control"
                                   required />

                            <span class="text-danger"
                                  asp-validation-for="UserId">
                            </span>

                        </div>


                        <div class="mb-4">

                            <label class="form-label fw-semibold">

                                New Password

                                <small class="text-muted">
                                    (Optional)
                                </small>

                            </label>

                            <input type="password"
                                   name="NewPassword"
                                   class="form-control"
                                   maxlength="16"
                                   placeholder="Leave blank to keep current password" />

                        </div>


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                💾 Update Admin

                            </button>


                            <a asp-controller="Admin"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>