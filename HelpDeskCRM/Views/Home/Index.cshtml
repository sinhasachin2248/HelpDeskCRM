@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">

    <!-- Animated Background -->
    <div class="ambient-bg">
        <div class="ambient-orb orb-one"></div>
        <div class="ambient-orb orb-two"></div>
        <div class="ambient-orb orb-three"></div>
        <div class="ambient-grid"></div>
    </div>

    <!-- Floating Particles -->
    <div class="particles">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
    </div>


    <!-- ================= HERO ================= -->

    <section class="hero-section">

        <div class="hero-content">

            <div class="status-pill">
                <span class="status-dot"></span>
                <span>SYSTEM ONLINE</span>
                <span class="status-pulse"></span>
            </div>

            <h1>
                Welcome to
                <span class="gradient-text">HelpDesk CRM</span>
            </h1>

            <p class="hero-description">
                Manage your customers, employees and support operations
                from one powerful workspace.
            </p>

            <div class="hero-actions">

                <a asp-controller="Tickets"
                   asp-action="Index"
                   asp-route-section="createTicket"
                   class="hero-button primary-btn">

                    <span class="btn-icon">＋</span>
                    Create Ticket
                    <span class="btn-arrow">→</span>

                </a>

                <a asp-controller="Tickets"
                   asp-action="Index"
                   asp-route-section="ticketList"
                   class="hero-button secondary-btn">

                    View Tickets
                    <span class="btn-arrow">→</span>

                </a>

            </div>

        </div>


        <!-- Hero Animation -->

        <div class="hero-visual">

            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="orbit orbit-three"></div>

            <div class="hero-core">

                <div class="core-glow"></div>

                <div class="shield-icon">
                    ◆
                </div>

                <span>CRM</span>

            </div>

            <div class="floating-badge badge-one">
                <span>●</span> Live
            </div>

            <div class="floating-badge badge-two">
                <span>✦</span> Secure
            </div>

            <div class="floating-badge badge-three">
                <span>✓</span> Active
            </div>

        </div>

    </section>


    <!-- ================= STATISTICS ================= -->

    <section class="stats-grid">

        <!-- Customers -->

        <div class="stat-card customer-card reveal-card">

            <div class="card-shine"></div>

            <div class="stat-top">

                <div class="stat-icon">
                    <span>◉</span>
                </div>

                <div class="stat-trend">
                    <span>↗</span>
                    Active
                </div>

            </div>

            <div class="stat-number counter"
                 data-target="@ViewBag.CustomerCount">
                0
            </div>

            <div class="stat-title">
                Total Customers
            </div>

            <div class="stat-bottom">

                <div class="mini-progress">
                    <span style="width:82%"></span>
                </div>

                <small>
                    Customer database
                </small>

            </div>

        </div>


        <!-- Employees -->

        <div class="stat-card employee-card reveal-card">

            <div class="card-shine"></div>

            <div class="stat-top">

                <div class="stat-icon">
                    <span>♙</span>
                </div>

                <div class="stat-trend">
                    <span>↗</span>
                    Team
                </div>

            </div>

            <div class="stat-number counter"
                 data-target="@ViewBag.EmployeeCount">
                0
            </div>

            <div class="stat-title">
                Total Employees
            </div>

            <div class="stat-bottom">

                <div class="mini-progress">
                    <span style="width:74%"></span>
                </div>

                <small>
                    Registered employees
                </small>

            </div>

        </div>


        <!-- Tickets -->

        <div class="stat-card ticket-card reveal-card">

            <div class="card-shine"></div>

            <div class="stat-top">

                <div class="stat-icon">
                    <span>◇</span>
                </div>

                <div class="stat-trend">
                    <span>↗</span>
                    Support
                </div>

            </div>

            <div class="stat-number counter"
                 data-target="@ViewBag.TicketCount">
                0
            </div>

            <div class="stat-title">
                Total Tickets
            </div>

            <div class="stat-bottom">

                <div class="mini-progress">
                    <span style="width:91%"></span>
                </div>

                <small>
                    Support requests
                </small>

            </div>

        </div>


        <!-- Pending -->

        <div class="stat-card pending-card reveal-card">

            <div class="card-shine"></div>

            <div class="stat-top">

                <div class="stat-icon">
                    <span>◷</span>
                </div>

                <div class="stat-trend warning">
                    <span>!</span>
                    Attention
                </div>

            </div>

            <div class="stat-number counter"
                 data-target="@ViewBag.PendingTickets">
                0
            </div>

            <div class="stat-title">
                Pending Tickets
            </div>

            <div class="stat-bottom">

                <div class="mini-progress">
                    <span style="width:43%"></span>
                </div>

                <small>
                    Requires attention
                </small>

            </div>

        </div>

    </section>


    <!-- ================= MANAGEMENT CENTER ================= -->

    <section class="section-block">

        <div class="section-heading">

            <div>

                <span class="section-label">
                    CONTROL CENTER
                </span>

                <h2>
                    Management Center
                </h2>

                <p>
                    Quickly access the core modules of your CRM.
                </p>

            </div>

            <div class="heading-line"></div>

        </div>


        <div class="management-grid">

            <!-- Customers -->

            <a asp-controller="Customers"
               asp-action="Index"
               class="management-card management-customer">

                <div class="management-glow"></div>

                <div class="management-icon">
                    ◉
                </div>

                <div class="management-content">

                    <span class="module-label">
                        MODULE 01
                    </span>

                    <h3>
                        Customers
                    </h3>

                    <p>
                        Manage customer profiles, records and information.
                    </p>

                </div>

                <div class="management-arrow">
                    →
                </div>

                <div class="card-line"></div>

            </a>


            <!-- Employees -->

            <a asp-controller="Employees"
               asp-action="Index"
               class="management-card management-employee">

                <div class="management-glow"></div>

                <div class="management-icon">
                    ♙
                </div>

                <div class="management-content">

                    <span class="module-label">
                        MODULE 02
                    </span>

                    <h3>
                        Employees
                    </h3>

                    <p>
                        Manage employees and their CRM activities.
                    </p>

                </div>

                <div class="management-arrow">
                    →
                </div>

                <div class="card-line"></div>

            </a>


            <!-- Tickets -->

            <a asp-controller="Tickets"
               asp-action="Index"
               class="management-card management-ticket">

                <div class="management-glow"></div>

                <div class="management-icon">
                    ◇
                </div>

                <div class="management-content">

                    <span class="module-label">
                        MODULE 03
                    </span>

                    <h3>
                        Tickets
                    </h3>

                    <p>
                        Monitor support tickets and resolve customer issues.
                    </p>

                </div>

                <div class="management-arrow">
                    →
                </div>

                <div class="card-line"></div>

            </a>

        </div>

    </section>


    <!-- ================= ANALYTICS ================= -->

    <section class="analytics-grid">

        <!-- System Overview -->

        <div class="glass-panel overview-panel">

            <div class="panel-header">

                <div>

                    <span class="section-label">
                        LIVE DATA
                    </span>

                    <h2>
                        System Overview
                    </h2>

                </div>

                <div class="live-indicator">

                    <span></span>
                    LIVE

                </div>

            </div>


            <div class="overview-items">

                <!-- Customer -->

                <div class="overview-row">

                    <div class="overview-info">

                        <div class="overview-icon customer-icon">
                            ◉
                        </div>

                        <div>

                            <strong>
                                Customers
                            </strong>

                            <small>
                                CRM accounts
                            </small>

                        </div>

                    </div>

                    <div class="overview-value">

                        <span class="counter"
                              data-target="@ViewBag.CustomerCount">
                            0
                        </span>

                    </div>

                </div>


                <!-- Employee -->

                <div class="overview-row">

                    <div class="overview-info">

                        <div class="overview-icon employee-icon">
                            ♙
                        </div>

                        <div>

                            <strong>
                                Employees
                            </strong>

                            <small>
                                Team members
                            </small>

                        </div>

                    </div>

                    <div class="overview-value">

                        <span class="counter"
                              data-target="@ViewBag.EmployeeCount">
                            0
                        </span>

                    </div>

                </div>


                <!-- Tickets -->

                <div class="overview-row">

                    <div class="overview-info">

                        <div class="overview-icon ticket-icon">
                            ◇
                        </div>

                        <div>

                            <strong>
                                Tickets
                            </strong>

                            <small>
                                Total requests
                            </small>

                        </div>

                    </div>

                    <div class="overview-value">

                        <span class="counter"
                              data-target="@ViewBag.TicketCount">
                            0
                        </span>

                    </div>

                </div>


                <!-- Pending -->

                <div class="overview-row">

                    <div class="overview-info">

                        <div class="overview-icon pending-icon">
                            ◷
                        </div>

                        <div>

                            <strong>
                                Pending
                            </strong>

                            <small>
                                Open requests
                            </small>

                        </div>

                    </div>

                    <div class="overview-value pending-value">

                        <span class="counter"
                              data-target="@ViewBag.PendingTickets">
                            0
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- System Health -->

        <div class="glass-panel health-panel">

            <div class="panel-header">

                <div>

                    <span class="section-label">
                        SYSTEM STATUS
                    </span>

                    <h2>
                        System Health
                    </h2>

                </div>

                <div class="health-orb"></div>

            </div>


            <div class="health-circle">

                <div class="circle-ring ring-one"></div>
                <div class="circle-ring ring-two"></div>

                <div class="circle-content">

                    <strong>
                        98%
                    </strong>

                    <span>
                        HEALTH
                    </span>

                </div>

            </div>


            <div class="health-details">

                <div class="health-item">

                    <div>

                        <span class="health-dot"></span>

                        API Services

                    </div>

                    <strong>
                        Operational
                    </strong>

                </div>


                <div class="health-item">

                    <div>

                        <span class="health-dot"></span>

                        Database

                    </div>

                    <strong>
                        Operational
                    </strong>

                </div>


                <div class="health-item">

                    <div>

                        <span class="health-dot"></span>

                        CRM Modules

                    </div>

                    <strong>
                        Operational
                    </strong>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= QUICK ACCESS ================= -->

    <section class="section-block quick-section">

        <div class="section-heading">

            <div>

                <span class="section-label">
                    SHORTCUTS
                </span>

                <h2>
                    Quick Access
                </h2>

                <p>
                    Jump directly into your most frequently used actions.
                </p>

            </div>

        </div>


        <div class="quick-grid">

            <!-- New Customer -->

            <a asp-controller="Customers"
               asp-action="Index"
               asp-route-section="addCustomer"
               class="quick-card quick-purple">

                <div class="quick-icon">
                    ＋
                </div>

                <div>

                    <span>
                        CREATE
                    </span>

                    <h3>
                        New Customer
                    </h3>

                </div>

                <div class="quick-arrow">
                    ↗
                </div>

            </a>


            <!-- New Employee -->

            <a asp-controller="Employees"
               asp-action="Index"
               asp-route-section="addEmployee"
               class="quick-card quick-blue">

                <div class="quick-icon">
                    ＋
                </div>

                <div>

                    <span>
                        CREATE
                    </span>

                    <h3>
                        New Employee
                    </h3>

                </div>

                <div class="quick-arrow">
                    ↗
                </div>

            </a>


            <!-- New Ticket -->

            <a asp-controller="Tickets"
               asp-action="Index"
               asp-route-section="createTicket"
               class="quick-card quick-pink">

                <div class="quick-icon">
                    ＋
                </div>

                <div>

                    <span>
                        CREATE
                    </span>

                    <h3>
                        New Ticket
                    </h3>

                </div>

                <div class="quick-arrow">
                    ↗
                </div>

            </a>


            <!-- View Tickets -->

            <a asp-controller="Tickets"
               asp-action="Index"
               asp-route-section="ticketList"
               class="quick-card quick-green">

                <div class="quick-icon">
                    →
                </div>

                <div>

                    <span>
                        EXPLORE
                    </span>

                    <h3>
                        View Tickets
                    </h3>

                </div>

                <div class="quick-arrow">
                    ↗
                </div>

            </a>

        </div>

    </section>


    <!-- ================= SYSTEM STATUS ================= -->

    <div class="system-status-bar">

        <div class="system-status-left">

            <div class="system-pulse">
                <span></span>
            </div>

            <div>

                <strong>
                    All systems operational
                </strong>

                <small>
                    HelpDesk CRM is running normally
                </small>

            </div>

        </div>


        <div class="system-status-right">

            <span>SECURE</span>
            <span>•</span>
            <span>ONLINE</span>
            <span>•</span>
            <span>READY</span>

        </div>

    </div>

</div>


<style>

    /* =========================================================
       GLOBAL
    ========================================================= */

    .dashboard-page {
        position: relative;
        min-height: 100vh;
        padding: 25px;
        overflow: hidden;
        background: radial-gradient( circle at 10% 10%, rgba(124,58,237,.10), transparent 30% ), radial-gradient( circle at 90% 20%, rgba(6,182,212,.10), transparent 30% ), radial-gradient( circle at 50% 90%, rgba(236,72,153,.08), transparent 35% ), #f7f8fc;
        color: #17172b;
    }


    /* =========================================================
       AMBIENT BACKGROUND
    ========================================================= */

    .ambient-bg {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
    }

    .ambient-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(70px);
        opacity: .25;
        animation: ambientFloat 12s ease-in-out infinite;
    }

    .orb-one {
        width: 280px;
        height: 280px;
        background: #8b5cf6;
        top: 5%;
        left: -100px;
    }

    .orb-two {
        width: 320px;
        height: 320px;
        background: #06b6d4;
        top: 35%;
        right: -120px;
        animation-delay: -4s;
    }

    .orb-three {
        width: 250px;
        height: 250px;
        background: #ec4899;
        bottom: -100px;
        left: 40%;
        animation-delay: -7s;
    }

    .ambient-grid {
        position: absolute;
        inset: 0;
        opacity: .25;
        background-image: linear-gradient( rgba(100,100,150,.06) 1px, transparent 1px ), linear-gradient( 90deg, rgba(100,100,150,.06) 1px, transparent 1px );
        background-size: 45px 45px;
        mask-image: linear-gradient( to bottom, black, transparent 80% );
    }


    /* =========================================================
       PARTICLES
    ========================================================= */

    .particles {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        overflow: hidden;
    }

        .particles span {
            position: absolute;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: #8b5cf6;
            opacity: .45;
            animation: particleMove 10s linear infinite;
        }

            .particles span:nth-child(1) {
                left: 8%;
                top: 30%;
                animation-duration: 12s;
            }

            .particles span:nth-child(2) {
                left: 18%;
                top: 70%;
                animation-duration: 16s;
            }

            .particles span:nth-child(3) {
                left: 28%;
                top: 20%;
                animation-duration: 14s;
            }

            .particles span:nth-child(4) {
                left: 39%;
                top: 80%;
                animation-duration: 18s;
            }

            .particles span:nth-child(5) {
                left: 48%;
                top: 35%;
                animation-duration: 11s;
            }

            .particles span:nth-child(6) {
                left: 58%;
                top: 15%;
                animation-duration: 17s;
            }

            .particles span:nth-child(7) {
                left: 68%;
                top: 65%;
                animation-duration: 13s;
            }

            .particles span:nth-child(8) {
                left: 76%;
                top: 25%;
                animation-duration: 15s;
            }

            .particles span:nth-child(9) {
                left: 85%;
                top: 75%;
                animation-duration: 19s;
            }

            .particles span:nth-child(10) {
                left: 92%;
                top: 40%;
                animation-duration: 13s;
            }

            .particles span:nth-child(11) {
                left: 14%;
                top: 50%;
                animation-duration: 20s;
            }

            .particles span:nth-child(12) {
                left: 72%;
                top: 88%;
                animation-duration: 16s;
            }


    /* =========================================================
       HERO
    ========================================================= */

    .hero-section {
        position: relative;
        z-index: 2;
        min-height: 390px;
        padding: 55px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        overflow: hidden;
        border-radius: 32px;
        background: linear-gradient( 120deg, #21164d, #4c1d95, #7c3aed, #2563eb, #0891b2 );
        background-size: 300% 300%;
        animation: gradientFlow 12s ease infinite;
        box-shadow: 0 30px 70px rgba(76,29,149,.25), inset 0 1px 0 rgba(255,255,255,.2);
    }

        .hero-section::before {
            content: "";
            position: absolute;
            width: 600px;
            height: 600px;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 50%;
            right: -250px;
            top: -220px;
            animation: rotateSlow 25s linear infinite;
        }

        .hero-section::after {
            content: "";
            position: absolute;
            width: 400px;
            height: 400px;
            border: 1px solid rgba(255,255,255,.10);
            border-radius: 50%;
            right: 100px;
            bottom: -300px;
            animation: rotateSlow 20s linear infinite reverse;
        }

    .hero-content {
        position: relative;
        z-index: 4;
        max-width: 700px;
        animation: heroEnter .9s ease forwards;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 8px 15px;
        border-radius: 50px;
        color: white;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.25);
        backdrop-filter: blur(15px);
        box-shadow: 0 8px 30px rgba(0,0,0,.12);
    }

    .status-dot {
        width: 7px;
        height: 7px;
        background: #4ade80;
        border-radius: 50%;
        box-shadow: 0 0 12px #4ade80;
        animation: statusBlink 1.5s infinite;
    }

    .status-pulse {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: rgba(255,255,255,.6);
    }

    .hero-section h1 {
        margin: 22px 0 12px;
        color: white;
        font-size: clamp(38px,5vw,65px);
        line-height: 1.05;
        font-weight: 900;
        letter-spacing: -2px;
    }

    .gradient-text {
        display: block;
        background: linear-gradient( 90deg, #ffffff, #c4b5fd, #67e8f9, #ffffff );
        background-size: 250%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: textGradient 5s linear infinite;
    }

    .hero-description {
        max-width: 560px;
        margin: 0;
        color: rgba(255,255,255,.78);
        font-size: 16px;
        line-height: 1.7;
    }

    .hero-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
        flex-wrap: wrap;
    }

    .hero-button {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 13px 20px;
        border-radius: 14px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
        transition: all .3s ease;
    }

    .primary-btn {
        color: #291052;
        background: white;
        box-shadow: 0 10px 30px rgba(0,0,0,.15);
    }

    .secondary-btn {
        color: white;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.25);
        backdrop-filter: blur(10px);
    }

    .hero-button:hover {
        transform: translateY(-4px);
        text-decoration: none;
        box-shadow: 0 15px 35px rgba(0,0,0,.22);
    }

    .btn-arrow {
        transition: transform .3s ease;
    }

    .hero-button:hover .btn-arrow {
        transform: translateX(5px);
    }


    /* =========================================================
       HERO VISUAL
    ========================================================= */

    .hero-visual {
        position: relative;
        width: 330px;
        height: 330px;
        flex-shrink: 0;
        margin-right: 40px;
    }

    .hero-core {
        position: absolute;
        width: 135px;
        height: 135px;
        left: 50%;
        top: 50%;
        transform: translate(-50%,-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: white;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.35);
        backdrop-filter: blur(20px);
        box-shadow: 0 0 50px rgba(255,255,255,.15), inset 0 0 30px rgba(255,255,255,.08);
        animation: coreFloat 4s ease-in-out infinite;
    }

        .hero-core span {
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 3px;
            margin-top: 5px;
        }

    .shield-icon {
        font-size: 38px;
        animation: iconPulse 2s ease-in-out infinite;
    }

    .core-glow {
        position: absolute;
        inset: -20px;
        border-radius: 50%;
        background: rgba(255,255,255,.08);
        filter: blur(20px);
        z-index: -1;
    }

    .orbit {
        position: absolute;
        left: 50%;
        top: 50%;
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 50%;
        transform: translate(-50%,-50%);
    }

    .orbit-one {
        width: 210px;
        height: 210px;
        animation: orbitRotate 10s linear infinite;
    }

    .orbit-two {
        width: 270px;
        height: 270px;
        animation: orbitRotate 16s linear infinite reverse;
    }

    .orbit-three {
        width: 325px;
        height: 325px;
        border-style: dashed;
        animation: orbitRotate 25s linear infinite;
    }

    .floating-badge {
        position: absolute;
        padding: 9px 13px;
        border-radius: 12px;
        color: white;
        font-size: 10px;
        font-weight: 800;
