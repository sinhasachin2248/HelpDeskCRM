    </style>

    <script>

        $(document).ready(function() {

            // =====================================================
            // NEXT-LEVEL EMPLOYEE PORTAL INTERACTIONS
            // =====================================================

            function updateEmployeeDashboardLayout() {
                var page = $(".employee-management-page");
                var width = window.innerWidth;

                page.removeClass(
                    "employee-dashboard-mobile employee-dashboard-small"
                );

                if (width <= 900) {
                    page.addClass("employee-dashboard-mobile");
                }

                if (width <= 600) {
                    page.addClass("employee-dashboard-small");
                }
            }

            updateEmployeeDashboardLayout();
            $(window).on("resize", updateEmployeeDashboardLayout);

            // Animated statistics.
            $(".count-up").each(function() {
                var element = $(this);
                var target = parseInt(element.attr("data-count"), 10) || 0;
                var duration = 850;
                var start = 0;
                var startTime = null;

                function animateCounter(timestamp) {
                    if (!startTime) {
                        startTime = timestamp;
                    }

                    var progress = Math.min(
                        (timestamp - startTime) / duration,
                        1
                    );

                    var eased = 1 - Math.pow(1 - progress, 3);
                    var value = Math.floor(start + ((target - start) * eased));

                    element.text(value);

                    if (progress < 1) {
                        window.requestAnimationFrame(animateCounter);
                    }
                }

                window.requestAnimationFrame(animateCounter);
            });

            // Cursor-responsive ambient movement.
            $(document).on("mousemove", function(event) {
                var x = (event.clientX / window.innerWidth) - 0.5;
                var y = (event.clientY / window.innerHeight) - 0.5;

                $(".employee-glow-1").css(
                    "transform",
                    "translate(" + (x * 25) + "px," + (y * 20) + "px)"
                );

                $(".employee-glow-2").css(
                    "transform",
                    "translate(" + (x * -20) + "px," + (y * -17) + "px)"
                );

                $(".employee-glow-3").css(
                    "transform",
                    "translate(" + (x * 13) + "px," + (y * -11) + "px)"
                );

                $(".employee-orb-1").css(
                    "transform",
                    "translate(" + (x * -15) + "px," + (y * 10) + "px)"
                );

                $(".employee-orb-2").css(
                    "transform",
                    "translate(" + (x * 12) + "px," + (y * -9) + "px)"
                );
            });

            // Continuous floating particles.
            var employeeMotion = 0;

            setInterval(function() {
                employeeMotion++;

                $(".dot-1").css("transform",
                    "translate(" + Math.sin(employeeMotion / 10) * 20 + "px," +
                    Math.cos(employeeMotion / 14) * 15 + "px)");

                $(".dot-2").css("transform",
                    "translate(" + Math.cos(employeeMotion / 12) * 17 + "px," +
                    Math.sin(employeeMotion / 9) * 20 + "px)");

                $(".dot-3").css("transform",
                    "translate(" + Math.sin(employeeMotion / 8) * 15 + "px," +
                    Math.cos(employeeMotion / 11) * 19 + "px)");

                $(".dot-4").css("transform",
                    "translate(" + Math.cos(employeeMotion / 15) * 20 + "px," +
                    Math.sin(employeeMotion / 11) * 14 + "px)");

                $(".dot-5").css("transform",
                    "translate(" + Math.sin(employeeMotion / 13) * 14 + "px," +
                    Math.cos(employeeMotion / 16) * 17 + "px)");
            }, 110);

            // Small 3D tilt for service/content cards.
            $(".employee-management-page > .row > .col-md-4 > .card, " +
                ".employee-management-page > .row > .col-md-8 > .card, " +
                ".snapshot-card").on("mousemove", function(event) {
                    var card = $(this);
                    var rect = this.getBoundingClientRect();

                    var px = (event.clientX - rect.left) / rect.width;
                    var py = (event.clientY - rect.top) / rect.height;

                    var rotateY = (px - 0.5) * 3.5;
                    var rotateX = (0.5 - py) * 3.5;

                    card.css(
                        "transform",
                        "perspective(900px) rotateX(" + rotateX +
                        "deg) rotateY(" + rotateY + "deg) translateY(-5px)"
                    );
                }).on("mouseleave", function() {
                    $(this).css("transform", "");
                });


            // PREMIUM FLOATING INTERACTIONS
            function updateEmployeeLayout() {
                var page = $(".employee-management-page");
                var width = window.innerWidth;

                page.removeClass("employee-mobile employee-small");

                if (width <= 900) {
                    page.addClass("employee-mobile");
                }

                if (width <= 600) {
                    page.addClass("employee-small");
                }
            }

            updateEmployeeLayout();
            $(window).on("resize", updateEmployeeLayout);

            // Cursor-reactive floating background.
            $(document).on("mousemove", function(event) {
                var x = (event.clientX / window.innerWidth) - 0.5;
                var y = (event.clientY / window.innerHeight) - 0.5;

                $(".employee-glow-1").css(
                    "transform",
                    "translate(" + (x * 22) + "px," + (y * 18) + "px)"
                );

                $(".employee-glow-2").css(
                    "transform",
                    "translate(" + (x * -18) + "px," + (y * -15) + "px)"
                );

                $(".employee-glow-3").css(
                    "transform",
                    "translate(" + (x * 12) + "px," + (y * -10) + "px)"
                );

                $(".employee-orb-1").css(
                    "transform",
                    "translate(" + (x * -13) + "px," + (y * 9) + "px)"
                );

                $(".employee-orb-2").css(
                    "transform",
                    "translate(" + (x * 10) + "px," + (y * -8) + "px)"
                );
            });

            var employeeFloatStep = 0;

            setInterval(function() {
                employeeFloatStep++;

                $(".dot-1").css("transform",
                    "translate(" + Math.sin(employeeFloatStep / 11) * 18 + "px," +
                    Math.cos(employeeFloatStep / 15) * 13 + "px)");

                $(".dot-2").css("transform",
                    "translate(" + Math.cos(employeeFloatStep / 13) * 15 + "px," +
                    Math.sin(employeeFloatStep / 10) * 18 + "px)");

                $(".dot-3").css("transform",
                    "translate(" + Math.sin(employeeFloatStep / 9) * 14 + "px," +
                    Math.cos(employeeFloatStep / 12) * 17 + "px)");

                $(".dot-4").css("transform",
                    "translate(" + Math.cos(employeeFloatStep / 16) * 18 + "px," +
                    Math.sin(employeeFloatStep / 12) * 12 + "px)");

                $(".dot-5").css("transform",
                    "translate(" + Math.sin(employeeFloatStep / 14) * 12 + "px," +
                    Math.cos(employeeFloatStep / 17) * 15 + "px)");
            }, 120);


            function isValidEmail(email) {

                var emailPattern =
                    /^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/;

                return emailPattern.test(email);
            }


            function isValidPhone(phone) {

                return /^[6-9][0-9]{9}$/.test(phone);
            }


            function isValidEmployeeId(id) {

                return /^[0-9]{5}$/.test(id);
            }


            function showValidation(message) {

                alert(message);
            }


            function validateEmployeeForm() {

                var employeeId =
                    $("#employeeId").val().trim();

                var firstName =
                    $("#employeeFirstName").val().trim();

                var lastName =
                    $("#employeeLastName").val().trim();

                var email =
                    $("#employeeEmail").val().trim();

                var phone =
                    $("#employeePhone").val().trim();

                var department =
                    $("#employeeDepartment").val();

                var designation =
                    $("#employeeDesignation").val();

                var city =
                    $("#employeeCity").val();


                if (employeeId === "") {

                    showValidation(
                        "Employee ID is required."
                    );

                    $("#employeeId").focus();

                    return false;
                }


                if (!isValidEmployeeId(employeeId)) {

                    showValidation(
                        "Employee ID must be exactly 5 digits."
                    );

                    $("#employeeId").focus();

                    return false;
                }


                if (firstName === "") {

                    showValidation(
                        "First Name is required."
                    );

                    $("#employeeFirstName").focus();

                    return false;
                }


                if (!/^[a-zA-Z ]+$/.test(firstName)) {

                    showValidation(
                        "First Name can contain only letters."
                    );

                    $("#employeeFirstName").focus();

                    return false;
                }


                if (lastName === "") {

                    showValidation(
                        "Last Name is required."
                    );

                    $("#employeeLastName").focus();

                    return false;
                }


                if (!/^[a-zA-Z ]+$/.test(lastName)) {

                    showValidation(
                        "Last Name can contain only letters."
                    );

                    $("#employeeLastName").focus();

                    return false;
                }


                if (email === "") {

                    showValidation(
                        "Email is required."
                    );

                    $("#employeeEmail").focus();

                    return false;
                }


                if (!isValidEmail(email)) {

                    showValidation(
                        "Please enter a valid email address."
                    );

                    $("#employeeEmail").focus();

                    return false;
                }


                if (phone === "") {

                    showValidation(
                        "Phone number is required."
                    );

                    $("#employeePhone").focus();

                    return false;
                }


                if (!isValidPhone(phone)) {

                    showValidation(
                        "Phone number must be exactly 10 digits and start with 6-9."
                    );

                    $("#employeePhone").focus();

                    return false;
                }


                if (department === "" ||
                    department === null) {

                    showValidation(
                        "Department is required."
                    );

                    $("#employeeDepartment").focus();

                    return false;
                }


                if (designation === "" ||
                    designation === null) {

                    showValidation(
                        "Designation is required."
                    );

                    $("#employeeDesignation").focus();

                    return false;
                }


                if (city === "" ||
                    city === null) {

                    showValidation(
                        "City is required."
                    );

                    $("#employeeCity").focus();

                    return false;
                }


                return true;
            }


            $("#employeeForm").on(
                "submit",
                function(event) {

                    if (!validateEmployeeForm()) {

                        event.preventDefault();

                        return false;
                    }

                }
            );


            $("#mobileForm").on(
                "submit",
                function(event) {

                    var mobile =
                        $("#mobileApiNumber").val().trim();

                    if (!isValidPhone(mobile)) {

                        event.preventDefault();

                        showValidation(
                            "Mobile number must be exactly 10 digits and start with 6-9."
                        );

                        $("#mobileApiNumber").focus();

                        return false;
                    }

                }
            );


            $("#btnClearEmployee").on(
                "click",
                function() {

                    $("#employeeForm")[0].reset();

                }
            );



            // =====================================================
            // MOBILE API FETCH VALIDATION / LOADING
            // =====================================================

            $("#mobileFetchForm").on("submit", function (event) {

                var mobile =
                    $("#mobileApiNumber").val().trim();

                if (!/^[6-9][0-9]{9}$/.test(mobile)) {

                    event.preventDefault();

                    showValidation(
                        "Mobile number must be exactly 10 digits and start with 6-9."
                    );

                    $("#mobileApiNumber").focus();

                    return false;
                }

                $("#fetchMobileButton")
                    .prop("disabled", true)
                    .html("⏳ FETCHING...");
            });


            $("#saveMobileResponseForm").on("submit", function () {

                $("#saveMobileResponseButton")
                    .prop("disabled", true)
                    .html("⏳ SAVING...");
            });
        });

    </script>
}